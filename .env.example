# Database: use a dedicated URL for this database in production, or inherit DATABASE_URL
# and set PORTAL_DATABASE_NAME=community_partner_events.
PORTAL_DATABASE_URL=
PORTAL_DATABASE_NAME=community_partner_events

# Server-side Firebase Admin configuration. Supply exactly one credential mechanism
# through the deployment secret manager, never through this file.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Generate and store this as a deployment secret. It signs the HttpOnly portal session cookie.
PORTAL_SESSION_SECRET=

# Optional. Set to 1 after the email-verification flow is enabled.
PORTAL_REQUIRE_VERIFIED_EMAIL=0

# Vite client configuration. These Firebase web-app identifiers are public configuration,
# but they still belong in the deployment environment rather than source control.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
